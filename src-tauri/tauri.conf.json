{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyricly",
  "version": "1.0.0",
  "identifier": "com.lyricly.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lyricly",
        "width": 680,
        "height": 76,
        "minWidth": 280,
        "minHeight": 45,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "center": true,
        "titleBarStyle": "Transparent"
      },
      {
        "label": "settings",
        "title": "Lyricly Settings",
        "width": 520,
        "height": 760,
        "minWidth": 460,
        "minHeight": 600,
        "decorations": true,
        "alwaysOnTop": false,
        "resizable": false,
        "maximizable": false,
        "shadow": true,
        "center": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
